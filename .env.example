# Servidor
PORT=3000
BASE_URL=chat.seudominio.com.br

# Fundação central (Node 22+ / SQLite)
CRM_DB_PATH=./data/crm.sqlite
CRM_ENCRYPTION_KEY=troque-por-uma-chave-longa-aleatoria-com-32-ou-mais-caracteres
CRM_SESSION_TTL_HOURS=12

# Primeira inicialização da organização e administrador
# Usados apenas quando o banco ainda está vazio.
CRM_ORGANIZATION_NAME=Loja Piloto
CRM_ADMIN_NAME=Administrador
CRM_ADMIN_EMAIL=admin@seudominio.com.br
CRM_ADMIN_PASSWORD=troque-por-uma-senha-forte-com-10-ou-mais-caracteres

# Conexão da organização com o Chatwoot
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=cole-o-token-da-conta-chatwoot-no-servidor

# Reativação Manual V1.3.6
# Comece com false no primeiro deploy. Ative somente após validar tela, banco e etiquetas.
REACTIVATION_SEND_ENABLED=false
REACTIVATION_ELIGIBLE_LABELS=aguardando-cpf-terceiro,fora-de-horario,aguardando-retorno-cliente
REACTIVATION_BLOCK_LABEL=reativacao-unica-enviada
REACTIVATION_MAX_RECIPIENTS=100
# Um único envio é processado por ciclo. Padrão: 3000 ms.
REACTIVATION_WORKER_INTERVAL_MS=3000

# Chatwoot signed webhook used to count customer replies to reactivation campaigns
REACTIVATION_CHATWOOT_WEBHOOK_SECRET=
REACTIVATION_WEBHOOK_MAX_SKEW_SECONDS=300

# Central de crédito (somente leitura / fail-closed)
CREDIT_PANEL_ENABLED=false
CREDIT_PANEL_WRITE_ENABLED=false
AUTOCORE_INTERNAL_BASE_URL=
AUTOCORE_CREDIT_OPERATIONS_TOKEN=
AUTOCORE_CREDIT_OPERATIONS_STORE_ID=
AUTOCORE_CREDIT_OPERATIONS_TIMEOUT_MS=5000
